rules_version = '2';

// ─────────────────────────────────────────────────────────────
//  Okulab Time — Firestore セキュリティルール
//
//  想定する運用: 合言葉を共有した研究室内の端末どうしで使う。
//
//  方針:
//   ・ログイン(匿名認証)していない端末は一切アクセスできない。
//   ・rooms/{roomId} の roomId は合言葉の SHA-256。クライアントから
//     コレクションを列挙する手段はないため、合言葉を知らない限り
//     どのルームにも到達できない。
//   ・保存されるデータの形を検証し、記録済みの開始時刻の改ざん、
//     操作者の詐称、進行中レコードの削除を防ぐ。
//
//  なお、合言葉を知っている利用者が「もっともらしい偽の記録」を
//  作ること自体は防げない(正規の操作と区別がつかないため)。
//  合言葉は推測されにくい文字列にしてください。
// ─────────────────────────────────────────────────────────────

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    // 時計同期用のプローブ。自分の分だけ読み書きできる。
    match /rooms/{roomId}/clock/{uid} {
      allow read:         if signedIn() && request.auth.uid == uid;
      allow create, update: if signedIn() && request.auth.uid == uid
                            && request.resource.data.keys().hasOnly(['t']);
      allow delete:       if signedIn() && request.auth.uid == uid;
    }

    // 進行中セッションの排他制御フラグ。
    // ここが壊れると開始/終了の対応付けが崩れるため、形を固定する。
    match /rooms/{roomId}/meta/{docId} {
      allow read: if signedIn();
      allow create, update: if signedIn()
          && docId == 'current'
          && request.resource.data.keys().hasOnly(['activeSessionId', 'updatedAt'])
          && (request.resource.data.activeSessionId == null
              || request.resource.data.activeSessionId is string);
      allow delete: if false;
    }

    // 開始の受領記録。計測記録の削除後も再送による復活を防ぐ。
    match /rooms/{roomId}/startReceipts/{sessionId} {
      allow read: if signedIn();
      allow create: if signedIn()
          && request.resource.data.keys().hasOnly(['startedBy'])
          && request.resource.data.startedBy == request.auth.uid
          && !exists(/databases/$(database)/documents/rooms/$(roomId)/sessions/$(sessionId))
          && getAfter(/databases/$(database)/documents/rooms/$(roomId)/sessions/$(sessionId)).data.mode in ['random', 'sequence']
          && getAfter(/databases/$(database)/documents/rooms/$(roomId)/sessions/$(sessionId)).data.startedBy == request.auth.uid;
      allow update, delete: if false;
    }

    // 計測記録。
    match /rooms/{roomId}/sessions/{sessionId} {

      function incoming() {
        return request.resource.data;
      }

      // 固定上限の各要素を検証する。旧版の tags 未送信も許可する。
      // 名前中の区切り文字等は %HH で保存するため、最大 (40 * 3) * 2 + 1 文字。
      function validTagAt(tags, i) {
        return tags.size() <= i || (tags[i] is string
            && tags[i].size() >= 3 && tags[i].size() <= 241
            && tags[i].matches('.+:.+'));
      }

      function validTags(tags) {
        return tags is list && tags.size() <= 20
            && validTagAt(tags, 0)
            && validTagAt(tags, 1)
            && validTagAt(tags, 2)
            && validTagAt(tags, 3)
            && validTagAt(tags, 4)
            && validTagAt(tags, 5)
            && validTagAt(tags, 6)
            && validTagAt(tags, 7)
            && validTagAt(tags, 8)
            && validTagAt(tags, 9)
            && validTagAt(tags, 10)
            && validTagAt(tags, 11)
            && validTagAt(tags, 12)
            && validTagAt(tags, 13)
            && validTagAt(tags, 14)
            && validTagAt(tags, 15)
            && validTagAt(tags, 16)
            && validTagAt(tags, 17)
            && validTagAt(tags, 18)
            && validTagAt(tags, 19)
            ;
      }

      function validRandomCreate() {
        return (!('mode' in incoming()) && !('randomBatchId' in incoming())
                && !('randomOutcome' in incoming()))
            || (incoming().mode in ['free', 'random']
                && incoming().randomOutcome == null
                && ((incoming().mode == 'free' && incoming().randomBatchId == null)
                    || (incoming().mode == 'random' && incoming().randomBatchId is string
                        && incoming().randomBatchId.size() > 0
                        && incoming().randomBatchId.size() <= 128
                        && getAfter(/databases/$(database)/documents/rooms/$(roomId)/startReceipts/$(sessionId)).data.startedBy == request.auth.uid)));
      }

      function validRandomOutcome() {
        return resource.data.status == 'done'
            && resource.data.mode == 'random'
            && resource.data.startedBy == request.auth.uid
            && resource.data.randomOutcome == null
            && incoming().randomOutcome in ['confirmed', 'discarded']
            && incoming().diff(resource.data).affectedKeys().hasOnly(['randomOutcome']);
      }

      // 旧版が新項目を省略する場合も、null を送る場合も許可する。
      function emptySequence() {
        return incoming().get('sequenceRunId', null) == null
            && incoming().get('sequenceTrial', null) == null
            && incoming().get('sequenceSet', null) == null
            && incoming().get('sequencePosition', null) == null
            && incoming().get('sequenceOutcome', null) == null
            && incoming().get('sequenceCondition', null) == null;
      }

      function validSequenceCreate() {
        return incoming().mode == 'sequence'
            && incoming().randomBatchId == null
            && incoming().randomOutcome == null
            && incoming().sequenceOutcome == null
            && incoming().sequenceRunId is string
            && incoming().sequenceRunId.size() >= 1 && incoming().sequenceRunId.size() <= 128
            && incoming().sequenceTrial is int
            && incoming().sequenceTrial >= 1 && incoming().sequenceTrial <= 1000
            && incoming().sequenceSet is int
            && incoming().sequenceSet >= 1 && incoming().sequenceSet <= 100
            && incoming().sequencePosition is int
            && incoming().sequencePosition >= 1 && incoming().sequencePosition <= 300
            && (incoming().get('sequenceCondition', null) == null
                || (incoming().sequenceCondition is string
                    && incoming().sequenceCondition.size() >= 1 && incoming().sequenceCondition.size() <= 200))
            && validTags(incoming().tags)
            && (incoming().tags.size() >= 1 || incoming().get('sequenceCondition', null) is string)
            && getAfter(/databases/$(database)/documents/rooms/$(roomId)/startReceipts/$(sessionId)).data.startedBy == request.auth.uid;
      }

      function validSequenceOutcome() {
        return resource.data.status == 'done'
            && resource.data.mode == 'sequence'
            && resource.data.startedBy == request.auth.uid
            && resource.data.sequenceOutcome == null
            && incoming().sequenceOutcome in ['confirmed', 'discarded']
            && incoming().diff(resource.data).affectedKeys().hasOnly(['sequenceOutcome']);
      }

      function validCreate() {
        return !exists(/databases/$(database)/documents/rooms/$(roomId)/startReceipts/$(sessionId))
            && incoming().status == 'running'
            && incoming().startMs is number
            && incoming().label is string
            && incoming().label.size() <= 200
            && (!('tags' in incoming()) || validTags(incoming().tags))
            && ((validRandomCreate() && emptySequence()) || validSequenceCreate())
            && incoming().startedBy == request.auth.uid
            && incoming().endMs == null
            && incoming().keys().hasOnly([
                 'status', 'label', 'tags', 'mode', 'randomBatchId', 'randomOutcome',
                 'sequenceRunId', 'sequenceTrial', 'sequenceSet', 'sequencePosition', 'sequenceOutcome', 'sequenceCondition',
                 'startMs', 'startRawMs', 'startOffsetMs', 'startAccuracyMs',
                 'startSynced', 'startedBy', 'startedAt',
                 'endMs', 'endRawMs', 'endOffsetMs', 'endAccuracyMs',
                 'endSynced', 'endedBy', 'endedAt',
                 'durationMs', 'durationSec'
               ]);
      }

      // 終了(done)と中止(aborted)で書き換わるのは終了側の項目だけ。
      // 開始時刻・ラベル・開始操作者は変更できない。
      function validUpdate() {
        return resource.data.status == 'running'
            && incoming().status in ['done', 'aborted']
            && incoming().endedBy == request.auth.uid
            && incoming().diff(resource.data).affectedKeys().hasOnly([
                 'status', 'endMs', 'endRawMs', 'endOffsetMs', 'endAccuracyMs',
                 'endSynced', 'endedBy', 'endedAt', 'durationMs', 'durationSec'
               ]);
      }

      allow read:   if signedIn();
      allow create: if signedIn() && validCreate();
      allow update: if signedIn() && (validUpdate() || validRandomOutcome() || validSequenceOutcome());
      allow delete: if signedIn() && resource.data.status != 'running';
    }
  }
}
